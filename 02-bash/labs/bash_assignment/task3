#!/bin/bash 


echo "Enter a file:" 
read file

if [ -f "$file" ]
then 
echo "file exists"
else
echo "file does not exist"
exit 1
fi 

if [ -r "$file" ]
then 
echo "file is readable"
else 
echo "file is not readbale"
fi

if [ -x "$file" ]
then 
echo "file is executable"
else
echo "file is not executable"
fi

if [ -w "$file" ]
then 
echo "file is writable"
else
echo "file is not writable" 
fi 
